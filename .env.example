DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
BACKEND_URL=http://localhost:8080
# Set the exact public HTTPS origin in production (no trailing slash).
AUTH_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Test provider requires Spring profile dev and a SEPARATE test database.
# Never enable against a production database; prod profile rejects this flag.
TEST_PAYMENTS_ENABLED=false
