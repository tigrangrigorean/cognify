DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
BACKEND_URL=http://localhost:8080
# Set the exact public HTTPS origin in production (no trailing slash).
AUTH_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Test provider requires Spring profile dev and a SEPARATE test database.
# Never enable against a production database; prod profile rejects this flag.
TEST_PAYMENTS_ENABLED=false
# disabled | openai | mock (mock requires dev and a separate test database)
AI_MODE=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GENERATION_WORKER_ENABLED=true
